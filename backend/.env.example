# Copy to backend/.env, then edit locally. Do not commit credentials.
AMIGA_ENV=development
# Empty DATABASE_URL uses backend/storage/amiga.db (SQLite, local development).
# PostgreSQL example: postgresql+psycopg://USER:PASSWORD@localhost:5432/amiga
DATABASE_URL=
# Local development creates a persistent secret in backend/storage/.session-secret.
# Production: set a random SECRET_KEY with at least 32 characters and serve HTTPS.
SECRET_KEY=
# Default: email + AMIGA password, bcrypt and JWT. Google is optional.
AUTH_METHOD=local_password
GOOGLE_CLIENT_ID=
# The owner must supply the real email. /admin alone never grants admin access.
ADMIN_BOOTSTRAP_EMAIL=
SESSION_HOURS=8
AWS_REGION=ap-southeast-1
# Invoice extraction: the supplied AWS Bedrock Nova backend. No provider fallback.
AI_PROVIDER=bedrock
# Existing reviewer second-opinion analysis remains separate from extraction.
OPENAI_MODEL=gpt-6-luna
# Keep credentials server-side. Reuse the existing key file, or use OPENAI_API_KEY/GPT_LUNA_API.
OPENAI_API_KEY_FILE=
OPENAI_API_KEY=
# Supply your own AWS credentials/profile server-side; never in frontend code.
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
START_QUEUE_WORKER=1

# All three role agents and initial uploader analysis use Luna.
AGENT_MODEL=gpt-6-luna
AGENT_DAILY_LIMIT=60
# Optional Telegram: use a dedicated bot without webhook for the local linking flow.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
